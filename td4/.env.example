# Copier en .env puis remplir : cp .env.example .env
POSTGRES_DB=visites
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme

# Port publié de l'API (défaut : 3000 en dev, 8000 en prod)
# API_PORT=8000
# Port publié de Postgres (dev uniquement, compose.override.yaml)
# DB_HOST_PORT=5432
# Image de l'API utilisée en prod (défaut : td4-api, construite localement)
# API_IMAGE=ghcr.io/<owner>/visites-api:<commit>

# En prod, le mot de passe de la base est un secret (hors git) :
#   mkdir -p secrets && printf 'motdepasse' > secrets/db_password.txt
